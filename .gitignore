# Secrets
.env
.env.*
*.pem
*.pfx
*.key

# Mail service dry-run output
sent-log/

# Dependencies and build output
node_modules/
visuals/*/dist/
visuals/*/.tmp/
visuals/*/webpack.statistics*.html

# Power BI local files
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/unappliedChanges.json

# Scratch output from earlier tooling
biproject_extract/
export_check/

# Logs
*.log

# Demo scratch (large recordings, test copy)
powerbi-demo/work/
powerbi-demo/tmp/*.mkv
powerbi-demo/tmp/clips/
powerbi-demo/tmp/*.png
powerbi-demo/tmp/ffmpeg.*
powerbi-demo/tmp/rec*-start.txt
