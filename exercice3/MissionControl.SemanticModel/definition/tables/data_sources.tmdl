	partition data_sources = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\data_sources.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
