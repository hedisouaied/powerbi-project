	partition alerts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\alerts.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
