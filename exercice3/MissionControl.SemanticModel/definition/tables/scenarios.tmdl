	partition scenarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\scenarios.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
