			& "<div style='margin-top:4px;font-size:12px;color:#8E80A0'>" & FORMAT(COUNTROWS(DimStore) + 0, "#,0", "en-US") & " stores &#183; <span style='color:#F28DB2'>" & FORMAT(_unknown, "#,0", "en-US") & " unknown</span></div>"
