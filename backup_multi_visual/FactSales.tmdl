			& "<div style='margin-top:12px;max-height:232px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:#5D4A78 transparent'><table style='width:100%;border-collapse:collapse'>" & "<thead><tr>" & "<th style='text-align:left;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#8E80A0;font-weight:600;padding:0 8px 8px;border-bottom:1px solid rgba(224,176,255,0.18);position:sticky;top:0;background:#16101F;white-space:nowrap'>Key</th>" & "<th style='text-align:left;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#8E80A0;font-weight:600;padding:0 8px 8px;border-bottom:1px solid rgba(224,176,255,0.18);position:sticky;top:0;background:#16101F;white-space:nowrap'>Product</th>" & "<th style='text-align:left;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#8E80A0;font-weight:600;padding:0 8px 8px;border-bottom:1px solid rgba(224,176,255,0.18);position:sticky;top:0;background:#16101F;white-space:nowrap'>Category</th>" & "<th style='text-align:right;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#8E80A0;font-weight:600;padding:0 8px 8px;border-bottom:1px solid rgba(224,176,255,0.18);position:sticky;top:0;background:#16101F;white-space:nowrap'>List Price</th>" & "</tr></thead><tbody>" & _rows & "</tbody></table></div></div>"
		displayFolder: 06 HTML
