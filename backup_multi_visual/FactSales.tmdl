	partition FactSales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\FactSales.csv"), [Delimiter = ",", Columns = 14, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Order_Line_ID", type text}, {"Order_ID", type text}, {"DateKey", Int64.Type}, {"CustomerKey", type text}, {"ProductKey", type text}, {"StoreKey", type text}, {"Quantity", Int64.Type}, {"Unit_Price_TND", type number}, {"Discount_Percent", type number}, {"Gross_Sales_TND", type number}, {"Net_Sales_TND", type number}, {"Order_Status", type text}, {"Revenue_Eligible", type text}, {"Data_Quality_Flag", type text}}, "en-US"),
				    Blanks = Table.ReplaceValue(Typed, "", null, Replacer.ReplaceValue, Table.ColumnsOfType(Typed, {type text, type nullable text}))
				in
				    Blanks
