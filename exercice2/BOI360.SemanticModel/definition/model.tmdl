model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","fnCleanText","departments","employees","projects","targets","tasks","customers","products","sales_transactions","expenses","leave_requests"]

annotation PBI_ProTooling = ["DevMode"]

ref table customers
ref table Date
ref table departments
ref table employees
ref table expenses
ref table leave_requests
ref table products
ref table projects
ref table project_managers
ref table sales_transactions
ref table targets
ref table tasks
ref table _Measures

